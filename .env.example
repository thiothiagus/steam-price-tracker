# Steam Price Tracker - Environment Variables
# Copy this file to .env and adjust values as needed.

# Database
DATABASE_URL=sqlite:///./app/data/steam_tracker.db

# Steam API
STEAM_CURRENCY=7

# Collector settings
COLLECTOR_DELAY_SECONDS=30.0
COLLECTOR_REFRESH_HOURS=1
COLLECTOR_MAX_RETRIES=3
COLLECTOR_BACKOFF_FACTOR=5.0
COLLECTOR_BASE_INTERVAL_MINUTES=5
COLLECTOR_MAX_ITEMS_PER_RUN=10
RUN_INITIAL_COLLECTION_ON_STARTUP=False

# Logging
LOG_LEVEL=INFO

# TBH Save file
TBH_APPID=3678970
SAVE_SOURCE_PATH=
SAVE_DEST_PATH=
SAVE_WATCHER_COOLDOWN_SECONDS=5.0
SAVE_WATCHER_POLL_INTERVAL=60.0
